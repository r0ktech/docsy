# ─────────────────────────────────────────────────────────────────────────────
# Docsy environment variables
# Copy to `.env` (local) or set in your host's dashboard (Vercel → Settings → Environment Variables).
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Public base URL of the app, no trailing slash. Used for OAuth redirects, email links and CSRF origin checks.
APP_URL="http://localhost:3000"

# PostgreSQL with the pgvector extension.
#   Local (PGlite, `npm run db:local`): postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&connection_limit=5&pgbouncer=true
#   Supabase: use the *session* pooler or direct connection string (port 5432), append ?sslmode=require
#   Neon: use the pooled connection string, append ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&connection_limit=5&pgbouncer=true"

# Optional: shown on the /contact page.
CONTACT_EMAIL=""

# ── Authentication ───────────────────────────────────────────────────────────
# Days a session stays valid (sliding).
SESSION_TTL_DAYS="30"

# Google OAuth (optional — the Google button only appears when both are set).
# Authorized redirect URI to register in Google Cloud Console: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Password-reset email via Resend (optional). Without it, reset links are printed
# to the server log in development, and the UI says email isn't configured.
RESEND_API_KEY=""
EMAIL_FROM=""          # e.g. "Docsy <no-reply@yourdomain.com>" (domain must be verified in Resend)

# ── File storage ─────────────────────────────────────────────────────────────
# "local" writes to LOCAL_STORAGE_DIR (development only — serverless disks are ephemeral).
# "s3" works with AWS S3, Supabase Storage (S3 endpoint), Cloudflare R2, MinIO…
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=".storage"
S3_BUCKET=""
S3_REGION=""           # e.g. us-east-1 (Supabase: your project region; R2: "auto")
S3_ENDPOINT=""         # leave empty for AWS; Supabase: https://<ref>.supabase.co/storage/v1/s3 ; R2: https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"   # "true" for Supabase and MinIO

# ── AI providers ─────────────────────────────────────────────────────────────
# Language model for answers: "anthropic" (default), "openai", or "mock" (tests only).
LLM_PROVIDER="anthropic"
LLM_MODEL=""           # default: claude-opus-5-5 (anthropic) / gpt-4.1 (openai)
LLM_FAST_MODEL=""      # titles, query rewriting, suggested questions. default: claude-haiku-5-5 / gpt-4.1-mini
LLM_EFFORT="medium"    # anthropic effort: low | medium | high | xhigh | max
ANTHROPIC_API_KEY=""

# Embeddings for search: "openai" (default), "voyage", or "mock" (tests only).
# All providers are configured to output 1024-dimensional vectors (fixed by the DB migration).
# Changing the embedding model later requires reprocessing documents (retry from the library).
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL=""     # default: text-embedding-3-small (openai) / voyage-3.5 (voyage)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""     # optional, for OpenAI-compatible endpoints
VOYAGE_API_KEY=""

# The mock providers refuse to run when NODE_ENV=production unless this is "true".
ALLOW_MOCK_AI="false"

# ── Retrieval tuning ─────────────────────────────────────────────────────────
RETRIEVAL_TOP_K="8"
RETRIEVAL_MIN_SIMILARITY="0.2"
CONTEXT_TOKEN_BUDGET="6000"
HISTORY_TOKEN_BUDGET="1500"

# ── Free-plan limits (enforced on the server, shown in the UI) ───────────────
MAX_UPLOAD_MB="20"
FREE_MAX_DOCUMENTS="25"
FREE_MAX_STORAGE_MB="250"
FREE_MAX_QUESTIONS_PER_MONTH="300"
MAX_PAGES_PER_DOCUMENT="500"

# ── Background jobs ──────────────────────────────────────────────────────────
# Secret for /api/jobs/run (Vercel Cron sends it as "Authorization: Bearer <secret>").
# Generate with: openssl rand -base64 32
CRON_SECRET=""
# Process uploads right after the response is sent (Next.js after()). Keep "true" on Vercel.
INLINE_JOBS="true"
